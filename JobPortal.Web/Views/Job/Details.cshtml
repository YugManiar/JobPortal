@model JobPortal.Web.Models.ViewModels.JobDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InfoMessage"] is not null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <a asp-action="Index" class="text-decoration-none small text-muted mb-3 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to job board
    </a>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
                <div>
                    <span class="badge bg-primary-subtle text-primary-emphasis mb-2">@Model.JobType</span>
                    <h2 class="fw-bold mb-1">@Model.Title</h2>
                    <p class="text-muted mb-0">
                        <i class="bi bi-building me-1"></i>@Model.CompanyName
                        <span class="mx-2">·</span>
                        <i class="bi bi-geo-alt me-1"></i>@Model.Location
                    </p>
                </div>

                <div class="text-end">
                    @if (Model.SalaryMin.HasValue || Model.SalaryMax.HasValue)
                    {
                        <p class="fw-semibold text-success mb-1">
                            @(Model.SalaryMin?.ToString("C0")) - @(Model.SalaryMax?.ToString("C0"))
                        </p>
                    }
                    <small class="text-muted">Posted @Model.PostedDateUtc.ToString("MMM dd, yyyy")</small>
                </div>
            </div>

            <hr />

            <h5 class="fw-semibold mb-2">Job Description</h5>
            <p class="text-body" style="white-space: pre-line;">@Model.Description</p>

            @if (Model.ApplicationDeadlineUtc.HasValue)
            {
                <p class="text-muted small mt-3">
                    <i class="bi bi-clock-history me-1"></i>
                    Apply before @Model.ApplicationDeadlineUtc.Value.ToString("MMM dd, yyyy")
                </p>
            }

            <div class="mt-4">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "Job", new { id = Model.Id })"
                       class="btn btn-primary px-4">
                        Log In to Apply
                    </a>
                }
                else if (User.IsInRole("Candidate"))
                {
                    @if (Model.CandidateHasApplied)
                    {
                        <button class="btn btn-success px-4" disabled>
                            <i class="bi bi-check-circle me-1"></i> Already Applied
                        </button>
                    }
                    else
                    {
                        <a asp-action="Apply" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                            Apply Now
                        </a>
                    }
                }
                else
                {
                    <span class="text-muted small">Only candidate accounts can apply to jobs.</span>
                }
            </div>
        </div>
    </div>
</div>